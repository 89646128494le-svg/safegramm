# Копировать в .env и заполнить перед: docker-compose -f docker-compose.production.yml up -d

# База данных
DB_USER=safegram
DB_PASSWORD=strong-password-here
DB_NAME=safegram_prod

# Redis
REDIS_PASSWORD=strong-redis-password

# Для сборки фронта (если API на том же домене — оставить пустым)
VITE_API_URL=
VITE_WS_URL=

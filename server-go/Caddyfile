# Замени api.yourdomain.com на свой поддомен (A-запись на IP сервера).
# Тогда Caddy сам получит SSL (Let's Encrypt). Без домена — используй блок :80 ниже.

{
	email your-email@example.com
}

# HTTP по IP (для проверок)
:80 {
	reverse_proxy api:8080
}

# HTTPS через nip.io (браузер не блокирует mixed content). Замени email на свой для Let's Encrypt.
141.8.198.152.nip.io {
	reverse_proxy api:8080
}

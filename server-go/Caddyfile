{
	email admin@safegram.site
}

www.safegram.site {
	redir https://safegram.site{uri} permanent
}

safegram.site {
	encode zstd gzip

	@backend path /api/* /ws* /uploads/* /health /metrics
	handle @backend {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv/safegram
		try_files {path} /index.html
		file_server
	}
}


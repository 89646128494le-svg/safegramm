# Замени api.yourdomain.com на свой поддомен (A-запись на IP сервера).
# Тогда Caddy сам получит SSL (Let's Encrypt). Без домена — используй блок :80 ниже.

{
	email your-email@example.com
}

# По умолчанию отвечаем на порту 80 (доступ по IP). Для домена с HTTPS раскомментируй блок ниже и закомментируй :80.
:80 {
	reverse_proxy api:8080
}

# Вариант с доменом (HTTPS):
# api.yourdomain.com {
# 	reverse_proxy api:8080
# }

# Database (PostgreSQL). Neon.tech: postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/safegram?sslmode=disable

# JWT (обязательно сменить в production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Server
PORT=8080
NODE_ENV=production

# Redis (опционально; для онлайн-статуса и кэша)
REDIS_URL=redis://localhost:6379/0
# С паролем: redis://:yourpassword@host:6379/0

# CORS (через запятую для нескольких доменов)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# В разработке можно: ALLOW_ALL_ORIGINS=true

# Email (Gmail пример)
EMAIL_PROVIDER=gmail
GMAIL_USER=your-app@gmail.com
GMAIL_APP_PASSWORD=app-password-from-google
EMAIL_FROM=your-app@gmail.com
EMAIL_FROM_NAME=SafeGram

# Web Push (VAPID ключи: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-app@gmail.com

# Safety AI (Gemini)
GEMINI_API_KEY=

# Логирование в Discord/Slack (опционально)
WEBHOOK_URL=

# Rate limiting (опционально)
# RATE_LIMIT_PER_MIN=100
# AUTH_RATE_LIMIT=30

# Защита от DDoS и злоупотреблений (опционально)
# SECURITY_GLOBAL_RATE_PER_MIN=400   — макс запросов/мин с одного IP
# SECURITY_MAX_BODY_MB=10            — макс размер тела запроса (MB)
# SECURITY_VIOLATIONS_TO_BAN=15      — после скольких 429 банить IP
# SECURITY_BAN_MINUTES=30            — длительность бана (минуты)
# SECURITY_WS_CONNS_PER_IP=5         — макс WebSocket соединений с одного IP
# SECURITY_IP_WHITELIST=1.2.3.4,10.0.0.1 — IP через запятую (не банить, не лимитить)

# Файловый лог с ротацией (путь к файлу; при пустом — только stderr)
# LOG_FILE=logs/safegram.log

# Платежи: вебхуки для обновления плана после оплаты
# Stripe: секрет вебхука (whsec_...)
# STRIPE_WEBHOOK_SECRET=
# ЮKassa: проверка по документации (при необходимости секрет в теле)
# YOOKASSA_SECRET=

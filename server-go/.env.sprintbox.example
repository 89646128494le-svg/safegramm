# Sprintbox / VDS — скопируй в .env и заполни.
# Команда: cp .env.sprintbox.example .env

# Обязательно: пароль БД (придумай надёжный)
POSTGRES_PASSWORD=сложный-пароль-для-postgres

# Обязательно: секрет JWT (минимум 32 символа). Сгенерировать: openssl rand -hex 32
JWT_SECRET=твой-длинный-секрет-минимум-32-символа

# Окружение
NODE_ENV=production
PORT=8080

# CORS: твой фронт на Vercel (и другие домены через запятую)
ALLOWED_ORIGINS=https://safegram-hazel.vercel.app,https://твой-домен.vercel.app

# Redis не обязателен; оставь пустым, если не используешь
REDIS_URL=

# Почта — нужна для отправки кодов входа на email. Без них «Отправить код» не сработает.
EMAIL_PROVIDER=gmail
GMAIL_USER=твой-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=SafeGram

# Логи в Discord (опционально)
# WEBHOOK_URL=

# SafeGram Go-ядро (cmd/server). Скопируй в .env и заполни.
# Загрузка: при запуске сервера из корня проекта .env подхватывается автоматически.

# —— Telegram (только для владельца Lev) ——
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
TELEGRAM_CHAT_ID=your_chat_id

# —— Safety AI (Gemini) ——
GEMINI_API_KEY=

# —— Мониторинг и нейросеть ——
MONITORING_INTERVAL=1h
ANOMALY_ALERT_THRESHOLD=0.75
ANOMALY_MODEL_PATH=models/anomaly_mlp.json

# —— Безопасность ——
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# —— Опционально ——
SAFEGRAM_ROOT=.
# Порты (если заняты): HTTP_PORT=8081 TCP_PORT=8084

# —— Проверка нейросети в боевых условиях ——
# 1) В Telegram боту: /status или /nn — текущая оценка по логам.
# 2) От владельца: POST /api/admin/test-ddos (Bearer токен) — симуляция аномалии, алерт в TG.
# 3) GET /api/admin/anomaly-score (owner) — JSON с score, severity, topReasons.
# 4) Скрипт флуда: .\scripts\test_ddos.ps1 — проверка rate limit по запросам.

{
  "name": "safegram-desktop",
  "version": "1.0.0",
  "description": "SafeGram Desktop — самостоятельное ПК-приложение, подключается к тому же серверу и БД",
  "author": "SafeGram",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:electron\"",
    "dev:web": "cd ../web && npm run dev",
    "dev:electron": "node scripts/wait-and-run.js",
    "build": "npm run build:web && npm run build:assets && npm run build:electron",
    "build:web": "cd ../web && npm run build && node ../desktop/scripts/copy-web-dist.js",
    "build:assets": "node scripts/generate-installer-assets.js",
    "clean": "node scripts/clean-dist.js",
    "build:electron": "node scripts/build-electron.js",
    "build:installer": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "electron-store": "^8.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.5",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.0.0"
  },
  "build": {
    "appId": "com.safegram.desktop",
    "productName": "SafeGram",
    "directories": { "output": "dist" },
    "files": ["main/**/*", "renderer/dist/**/*", "renderer/preload.js", "package.json"],
    "win": { "target": [{"target": "nsis", "arch": ["x64", "ia32"]}], "icon": "assets/icon.ico", "signAndEditExecutable": false },
    "mac": { "target": ["dmg"], "icon": "assets/icon.icns" },
    "linux": { "target": ["AppImage", "deb"], "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "SafeGram",
      "shortcutName": "SafeGram",
      "installerLanguages": ["ru_RU", "en_US"],
      "displayLanguageSelector": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "license": "build/license_ru.txt"
    }
  }
}
